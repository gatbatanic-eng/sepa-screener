                        "type": "string",
                        "description": "조회시작일자 / 길이 8 / YYYYMMDD"
                      },
                      "iqr_end_dt": {
                        "type": "string",
                        "description": "조회종료일자 / 길이 8 / YYYYMMDD"
                      },
                      "act_trd_dtl_cd": {
                        "type": "string",
                        "description": "계좌거래세부코드 / 길이 2 / 01.전체\nAA.입금\nBB.출금"
                      }
                    },
                    "required": [
                      "iqr_tp_cd",
                      "act_no",
                      "iqr_sta_dt",
                      "iqr_end_dt",
                      "act_trd_dtl_cd"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Output_0": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "trd_dt": {
                            "type": "string",
                            "description": "거래일자 / 길이 8 / YYYYMMDD"
                          },
                          "trd_amt": {
                            "type": "number",
                            "format": "double",
                            "description": "거래금액 / 길이 18.2"
                          },
                          "trd_af_dca": {
                            "type": "number",
                            "format": "double",
                            "description": "거래후예수금 / 길이 18.2"
                          },
                          "opi_cus_fnm": {
                            "type": "string",
                            "description": "상대고객성명 / 길이 40"
                          },
                          "sps_cd_krl_anm": {
                            "type": "string",
                            "description": "적요코드한글약명 / 길이 50"
                          },
                          "act_trd_tp_nm": {
                            "type": "string",
                            "description": "계좌거래유형명 / 길이 50"
                          },
                          "cli_pe_fnm": {
                            "type": "string",
                            "description": "의뢰인성명 / 길이 40"
                          },
                          "ral_trd_dt": {
                            "type": "string",
                            "description": "실거래일자 / 길이 8 / YYYYMMDD"
                          }
                        }
                      }
                    },
                    "message": {
                      "$ref": "#/components/schemas/Message"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization: Bearer {access_token} — REST 호출에 필요한 유일한 인증 헤더 (x-client-id·x-client-secret 불필요)"
      }
    },
